# Content Manager self-hosted configuration
# Copy to .env and replace every CHANGE_ME value.

DB_USER=content_manager
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=content_manager

BACKEND_SECRET_KEY=CHANGE_ME_BACKEND_SECRET
SERVICE_ACCOUNT_TOKEN=CHANGE_ME_SERVICE_TOKEN

OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
AI_GENERATION_PROVIDER=openai
AI_TRANSFORMATION_PROVIDER=openai

BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
ADMINS=CHANGE_ME_TELEGRAM_ADMIN_ID
WEBAPP_URL=https://content.example.com
FRONTEND_PUBLIC_URL=https://content.example.com
# WEBAPP_URL and FRONTEND_PUBLIC_URL must use the public HTTPS origin.
# WEBAPP_URL=https://content.example.com
FRONTEND_HOST=content.example.com
FRONTEND_SECRET_KEY=CHANGE_ME_FRONTEND_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com

SCHEDULE_CHECK_INTERVAL_SECONDS=10
PUBLICATION_WORKER_ID=telegram:content-manager
PUBLICATION_POLL_INTERVAL_SECONDS=5
PUBLICATION_LEASE_HEARTBEAT_INTERVAL_SECONDS=60
PUBLICATION_RECONCILIATION_POLL_INTERVAL_SECONDS=30
PUBLICATION_LEASE_TIMEOUT_SECONDS=900
PUBLICATION_MAX_ATTEMPTS=5
PUBLICATION_RETRY_DELAY_SECONDS=60
PUBLICATION_RETRY_MAX_DELAY_SECONDS=3600
